# Template for .env — copy it:  cp .env.example .env   then fill in the real value.
# .env is git-ignored and must never be committed. This example file holds no secrets.
#
# Supabase dashboard -> Connect -> "Session pooler" connection string (SQLAlchemy format).
# The "postgresql+psycopg2://" prefix tells SQLAlchemy to use the psycopg2 driver.
DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
